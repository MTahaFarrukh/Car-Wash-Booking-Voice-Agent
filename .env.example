# Database (local PostgreSQL or Supabase direct connection)
# Local example:
DATABASE_URL=postgresql://user:pass@localhost:5432/carwash_ai
# Supabase example (from Project Settings → Database → Connection string):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Supabase (Phase 6)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Uplift AI Voice (Phase 8)
UPLIFT_API_KEY=
UPLIFT_AGENT_ID=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# WhatsApp Baileys bridge (Phase 6) — shared secret for service-to-service auth
WHATSAPP_BRIDGE_SECRET=change-me-to-a-long-random-string
