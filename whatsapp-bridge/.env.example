# FastAPI backend base URL
BACKEND_URL=http://127.0.0.1:8000

# Must match WHATSAPP_BRIDGE_SECRET in the monorepo root .env
WHATSAPP_BRIDGE_SECRET=change-me-to-a-long-random-string

# Directory for persistent Baileys auth state (not committed to git)
WHATSAPP_SESSION_PATH=./auth_info

# Optional: log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info
