# FastAPI server
HOST=0.0.0.0
PORT=8000

# Public URL for VAPI webhook (use ngrok URL when testing)
# Example: PUBLIC_URL=https://abc123.ngrok-free.app
PUBLIC_URL=http://localhost:8000

# VAPI (configure in VAPI Dashboard)
VAPI_API_KEY=your_vapi_api_key

# Uplift AI Voice (configure in Uplift Dashboard)
UPLIFT_API_KEY=your_uplift_api_key
UPLIFT_ASSISTANT_ID=your_assistant_id
