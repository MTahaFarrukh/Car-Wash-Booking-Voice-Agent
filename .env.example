# Database (local PostgreSQL or Supabase direct connection)
# Local example:
DATABASE_URL=postgresql://user:pass@localhost:5432/carwash_ai
# Supabase example (from Project Settings → Database → Connection string):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- PRIVATE backend (never put these in NEXT_PUBLIC_*) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production frontend URL (merged into CORS). Dev can leave blank if CORS_ORIGINS set.
FRONTEND_URL=
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Uplift AI Voice (Phase 8 / 8.1)
UPLIFT_API_KEY=
UPLIFT_AGENT_ID=
UPLIFT_WEBHOOK_SECRET=

# VAPI Voice (Phase 8.1)
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_WEBHOOK_SECRET=

# Active voice transport: vapi | uplift | fake | auto
VOICE_PROVIDER=auto
VOICE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# WhatsApp Baileys bridge (Phase 6)
WHATSAPP_BRIDGE_SECRET=change-me-to-a-long-random-string

# LLM WhatsApp agent (Phase 7 / 7.1)
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_CALLS=8
WHATSAPP_AGENT_MODE=auto

# --- PUBLIC frontend (also copy into frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
