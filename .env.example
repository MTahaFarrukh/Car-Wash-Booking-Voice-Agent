# Database (local PostgreSQL or Supabase direct connection)
# Local example:
DATABASE_URL=postgresql://user:pass@localhost:5432/carwash_ai
# Supabase example (from Project Settings → Database → Connection string):
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Supabase (Phase 6)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Uplift AI Voice (Phase 8 / 8.1)
# Docs: https://docs.upliftai.org — tools are client-side RPC; proxy to /api/voice/tools/execute
UPLIFT_API_KEY=
UPLIFT_AGENT_ID=
UPLIFT_WEBHOOK_SECRET=

# VAPI Voice (Phase 8.1)
# Docs: https://docs.vapi.ai/server-url/events
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Bearer / X-Vapi-Secret / optional HMAC for POST /api/voice/vapi/webhook
VAPI_WEBHOOK_SECRET=

# Active voice transport: vapi | uplift | fake | auto
VOICE_PROVIDER=auto
# Shared secret for Sparkle-canonical voice endpoints (header: X-Voice-Webhook-Secret)
VOICE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
# Public WhatsApp number for wa.me links (digits only, country code, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER=923001234567
# VAPI browser SDK — Public key only (never VAPI_API_KEY / webhook secrets)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# Backend
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# WhatsApp Baileys bridge (Phase 6) — shared secret for service-to-service auth
WHATSAPP_BRIDGE_SECRET=change-me-to-a-long-random-string

# LLM WhatsApp agent (Phase 7 / 7.1)
# Provider: gemini (default) | openai | none
# Note: Google AI Plus (consumer chat) is NOT the same as Gemini API developer access.
# Get a developer key from https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional OpenAI provider (only when LLM_PROVIDER=openai)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=45
LLM_MAX_TOOL_CALLS=8
# auto = LLM when API key set, else rule-based; llm = prefer LLM; rule = force Phase 6 agent
WHATSAPP_AGENT_MODE=auto
